{
  "browser": {
    "channel": "msedge",
    "headless": true,
    "slow_mo_ms": 80,
    "profile_root": "~/.scnet-browser-profiles",
    "persist_session_state": true,
    "session_state_filename": "n019_browser_state.json",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "base_url": "https://www.scnet.cn/ui/console/index.html",
    "model_training_url": "https://www.scnet.cn/ui/console/index.html#/model-training/add-train",
    "task_list_page_url": "https://www.scnet.cn/ui/console/index.html#/model-training",
    "timeout_ms": 180000,
    "password_prompt": false,
    "manual_login_timeout_seconds": 120,
    "password_env_prefix": "SCNET_PASSWORD_",
    "shared_password_env": "SCNET_PASSWORD",
    "ui": {
      "login_ready_selector": "#instanceName, #username",
      "username_selector": "#username",
      "password_selector": "#password",
      "captcha_selector": "#captcha",
      "login_button_name": "登录",
      "login_url_fragment": "/sso/login",
      "task_name_selector": "#instanceName",
      "form_item_xpath": "xpath=ancestor::div[contains(concat(' ', normalize-space(@class), ' '), ' el-form-item ')][1]",
      "refresh_button_name": "刷新",
      "resource_row_selector": "tr",
      "task_row_selector": "tr",
      "cards_label": "每实例加速卡数量",
      "instances_label": "实例数",
      "auto_fault_label": "自动容错",
      "visible_popper_selector": ".el-popper:visible",
      "cascader_node_selector": ".el-cascader-node:not(.is-disabled)",
      "image_placeholder": "请选择基础镜像",
      "image_value_separator": " / ",
      "startup_editor_selector": ".CodeMirror",
      "terms_label": "我已阅读并同意",
      "create_button_name": "创建",
      "task_id_regex": "ID\\s*[：:]?\\s*(\\d{10,})",
      "status_regex": "状态\\s*[：:]?\\s*([^\\s]+)"
    }
  },
  "output_root": "runs/scnet_browser_submissions",
  "dry_run": true,
  "max_tasks_per_run": 1,
  "defaults": {
    "region": "华中一区【A区】",
    "accelerator": "异构加速卡BW",
    "resource_group": "113 组",
    "cards": 1,
    "instances": 1,
    "auto_fault": false,
    "auto_fault_retry_limit": 3,
    "accept_terms": true,
    "cpu_per_card": 15,
    "memory_gb_per_card": 59,
    "expected_resource_text": [
      "异构加速卡BW",
      "内存59GB",
      "CPU型号：15核",
      "DTK 26.04"
    ],
    "allowed_start_prefixes": [
      "bash ",
      "python ",
      "torchrun ",
      "timeout "
    ],
    "image": {
      "framework": "PyTorch",
      "version": "2.9.0",
      "python": "py3.11-Ubuntu22.04",
      "dtk": "dtk26.04"
    },
    "wall_hours": 1.25,
    "expected_card_hours": 0.5,
    "worst_card_hours": 1.25
  },
  "tasks": [
    {
      "id": "d10-inspect",
      "enabled": true,
      "submit": false,
      "name": "n019_inspect_{timestamp}",
      "account": "a094f4d10",
      "startup_script": "bash /public/home/a094f4d10/voice_projects/code/n019_official/scripts/run_full_eval_param_ai.sh"
    }
  ],
  "inspection": {
    "accounts": [
      "a094f4d10"
    ],
    "balance_label": "机时余量",
    "balance_value_selector": ".el-descriptions-item__content",
    "balance_regex": "([0-9]+(?:\\.[0-9]+)?)\\s*卡\\s*\\*?\\s*时"
  }
}
